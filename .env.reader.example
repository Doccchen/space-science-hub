# Local paper search service. Copy to .env.reader; never commit real keys.
READER_MODEL_KEY=
READER_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
READER_MODEL=qwen-plus
READER_SITE_DAILY_CALLS=100
# Optional: reduces shared anonymous rate-limit pressure at Semantic Scholar.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: Wanfang AI HUB (wfdata.com) APP_KEY. Backend only.
READER_WANFANG_API_KEY=
# Production: exact public origin, e.g. https://example.org
READER_PUBLIC_ORIGIN=
