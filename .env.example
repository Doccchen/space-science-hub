# Default: private test via SSH port forwarding.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
COLLECT_INTERVAL_SECONDS=3600
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
RESOURCE_OSS_ORIGIN=https://space-hub-pub.oss-cn-chengdu.aliyuncs.com
# Container path; local runs use the project content/resources.json by default.
RESOURCES_PATH=/app/content/resources.json
# Private review service (access through SSH forwarding; no public port).
ADMIN_ORIGIN=http://127.0.0.1:18080
GOVERNMENT_FULLTEXT_AUTO=1
# Knowledge-chat: disabled until the server operator configures a key.
AI_ENABLED=0
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=llm-ep9bqc9mnw50k8e0
BAILIAN_AGENT_ID=aid-066ddd0b6e1e44d6bf7d620e0ac7c060
AI_CONFIG_VERSION=1
AI_COOKIE_SECURE=0
AI_TIMEOUT_SECONDS=60
AI_CONCURRENCY=2
AI_VISITOR_DAILY_LIMIT=20
AI_IP_DAILY_LIMIT=30
AI_SITE_DAILY_LIMIT=100
AI_DAILY_TOKEN_LIMIT=200000
AI_TOKEN_RESERVATION=20000
# Independent news application. Shares AI global quotas and the mounted master key.
NEWS_AGENT_ENABLED=0
NEWS_CONTEXT_ENABLED=0
NEWS_AGENT_APP_ID=e366df4514cb4606b95821b9d03c387e
NEWS_AGENT_WORKSPACE_ID=llm-ep9bqc9mnw50k8e0
NEWS_AGENT_REGION=beijing
NEWS_AGENT_API_KEY=
NEWS_AGENT_CONFIG_VERSION=news-agent-v1
# Enable only after HTTPS reachability and per-request trusted header forwarding are tested.
NEWS_MCP_ENABLED=0
NEWS_MCP_CONTEXT_VERIFIED=0
NEWS_MCP_SERVICE_KEY=
NEWS_MCP_PLUGIN_CODE=
