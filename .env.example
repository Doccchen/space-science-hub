# Default: private test via SSH port forwarding.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
COLLECT_INTERVAL_SECONDS=3600
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
RESOURCE_OSS_ORIGIN=https://space-hub-pub.oss-cn-chengdu.aliyuncs.com
# Container path; local runs use the project content/resources.json by default.
RESOURCES_PATH=/app/content/resources.json
